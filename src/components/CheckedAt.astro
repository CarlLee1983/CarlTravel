---
import { isStale } from "../content/presentation.ts";
interface Props {
  checkedAt: string;
  buildDate: string;
}
const { checkedAt, buildDate } = Astro.props;
---

<p class="meta checked-at">
  官方資訊 · 查證日期 <time datetime={checkedAt}>{checkedAt}</time>
</p>
{
  isStale(checkedAt, buildDate) && (
    <p class="stale-note">資料可能過期，出發前請重新確認官方公告。</p>
  )
}

<style>
  .checked-at {
    font-size: 14px;
    margin-block: 12px 20px;
  }
  .stale-note {
    font-size: 15px;
    padding: 12px 16px;
    background: var(--surface);
    border-left: 3px solid var(--ground);
    border-radius: 0 8px 8px 0;
  }
</style>
