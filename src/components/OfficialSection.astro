---
import type { SpotData } from "../content/schema.ts";
import CheckedAt from "./CheckedAt.astro";
interface Props {
  id: string;
  title: string;
  section: SpotData["transport"];
  refs: SpotData["officialRefs"];
  buildDate: string;
}
const { id, title, section, refs, buildDate } = Astro.props;
const reference = (id: string) => refs.find((r) => r.id === id)!;
---

<section id={id} tabindex="-1" aria-labelledby={`${id}-heading`}>
  <span class="info-label official">官方資訊</span>
  <h2 id={`${id}-heading`}>{title}</h2>
  <CheckedAt checkedAt={section.checkedAt} buildDate={buildDate} />
  <dl>
    {
      section.facts.map((fact) => (
        <div>
          <dt>{fact.label}</dt>
          <dd>
            {fact.status === "ok" ? (
              <>
                {fact.value}{" "}
                <a href={reference(fact.ref).url}>
                  出處：{reference(fact.ref).title}
                </a>
              </>
            ) : fact.status === "unpublished" ? (
              "官方未公布"
            ) : (
              <>
                <p class="conflict">官方資訊有衝突</p>
                <ul>
                  {fact.claims.map((claim) => (
                    <li>
                      {claim.value}{" "}
                      <a href={reference(claim.ref).url}>
                        出處：{reference(claim.ref).title}
                      </a>
                    </li>
                  ))}
                </ul>
                <p>{fact.contact}</p>
              </>
            )}
          </dd>
        </div>
      ))
    }
  </dl>
</section>
<style>
  dl {
    margin-block: 24px 0;
  }
  dl > div {
    display: grid;
    grid-template-columns: minmax(110px, 0.4fr) minmax(0, 1fr);
    gap: 20px;
    padding-block: 20px;
    border-bottom: 1px solid var(--line);
  }
  dt {
    font-weight: 600;
  }
  dd {
    margin: 0;
    min-width: 0;
    line-height: 1.85;
  }
  dl a {
    display: block;
    margin-top: 8px;
    font-size: 0.875rem;
  }
  .conflict {
    margin-top: 0;
    font-weight: 600;
    background: var(--surface);
    padding: 6px 10px;
    border-radius: 6px;
  }
  @media (max-width: 600px) {
    dl > div {
      grid-template-columns: 1fr;
      gap: 8px;
    }
  }
</style>
