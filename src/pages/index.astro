---
import Layout from "../layouts/Layout.astro";
import { loadSpots } from "../content/load.ts";
import { contentMode } from "../content/mode.ts";
import { ageBands, ageBandRanges } from "../content/search.ts";
import { ageLabel } from "../content/schema.ts";
const spots = await loadSpots(contentMode().root);
const usedAges = new Set(spots.flatMap((spot) => ageBands(spot.ageRange)));
const filters = [
  {
    name: "county",
    label: "縣市",
    all: "全部縣市",
    values: [...new Set(spots.map((spot) => spot.county))],
  },
  {
    name: "kind",
    label: "類型",
    all: "全部類型",
    values: [...new Set(spots.map((spot) => spot.kind))],
  },
  {
    name: "setting",
    label: "環境",
    all: "全部環境",
    values: [...new Set(spots.map((spot) => spot.setting))],
  },
  {
    name: "age",
    label: "年齡帶",
    all: "全部年齡",
    values: [...ageBandRanges.map((band) => band.label), "年齡未標示"].filter(
      (label) => usedAges.has(label),
    ),
  },
];
---

<Layout title="找一處，一起出發">
  <div class="browse-layout">
    <div class="browse-rail">
      <p class="eyebrow">探索台灣 · 和孩子一起</p>
      <h1>找一處，<br />一起出發。</h1>
      <p>整理台灣親子景點，讓出遊前的準備更清楚。</p>
      <p>Agent 研究查證、整理草稿，經 Carl 審閱後公開。</p>
      <ul class="information-types">
        <li>
          <span class="info-label official">官方資訊</span><p>
            事實附官方出處與查證日期。
          </p>
        </li>
        <li>
          <span class="info-label author">原作者心得</span><p>
            轉述造訪觀點，連回完整原文。
          </p>
        </li>
        <li>
          <span class="info-label agent">Agent 建議</span><p>
            提供規劃參考，與事實分開。
          </p>
        </li>
      </ul>
      <aside aria-labelledby="browse-heading" class="browse-tools">
        <h2 id="browse-heading">搜尋與篩選</h2>
        <form id="spot-search" role="search" aria-label="景點搜尋與篩選">
          <fieldset disabled>
            <legend class="sr-only">搜尋與出遊條件</legend>
            <label for="query">搜尋景點</label>
            <input
              id="query"
              name="query"
              type="search"
              placeholder="景點名稱或內容"
              autocomplete="off"
            />
            {
              filters.map((filter) => (
                <div class="filter">
                  <label for={`filter-${filter.name}`}>{filter.label}</label>
                  <select id={`filter-${filter.name}`} name={filter.name}>
                    <option value="">{filter.all}</option>
                    {filter.values.map((value) => (
                      <option value={value}>{value}</option>
                    ))}
                  </select>
                </div>
              ))
            }
            <div class="search-actions">
              <button type="submit">搜尋</button>
              <button type="reset">清除條件</button>
            </div>
          </fieldset>
        </form>
        <p id="search-help">
          搜尋與篩選需要 JavaScript；仍可從下方瀏覽全部景點。
        </p>
      </aside>
    </div>
    <section aria-labelledby="spots-heading" class="results">
      <div class="results-heading">
        <h2 id="spots-heading">
          景點列表 <span id="result-count" class="meta">{spots.length}</span>
        </h2>
        <p class="meta">依縣市北到南 · 同縣市依名稱</p>
      </div>
      <p id="search-status" role="status" aria-live="polite" aria-atomic="true">
      </p>
      <p id="no-results" class="empty" hidden>
        沒有符合條件的景點，請調整搜尋文字或清除條件。
      </p>
      {
        spots.length === 0 ? (
          <div class="empty">
            <p>目前尚無公開景點，待內容完成查證與審閱後陸續加入。</p>
          </div>
        ) : (
          <ul class="spots">
            {spots.map((spot) => (
              <li
                data-spot-url={`/spots/${spot.id}/`}
                data-county={spot.county}
                data-kind={spot.kind}
                data-setting={spot.setting}
                data-age={ageBands(spot.ageRange).join("|")}
              >
                <article>
                  <div>
                    <h3>
                      <a href={`/spots/${spot.id}/`}>{spot.name}</a>
                    </h3>
                    <p class="meta">
                      {spot.county} · {spot.district} / {spot.kind}
                    </p>
                  </div>
                  <p>{spot.summary}</p>
                  <div class="spot-details">
                    <p>{spot.setting}</p>
                    <p class="meta">{ageLabel(spot.ageRange)}</p>
                  </div>
                </article>
              </li>
            ))}
          </ul>
        )
      }
    </section>
  </div>
</Layout>
<script>
  import "../browser/search.ts";
</script>
<style>
  fieldset {
    border: 0;
    padding: 0;
    margin: 16px 0 0;
    min-width: 0;
  }
  label {
    display: block;
    font-size: 0.875rem;
    font-weight: 600;
    margin-top: 12px;
  }
  input,
  select,
  button {
    font: inherit;
    font-size: 1rem;
  }
  input,
  select {
    width: 100%;
    min-width: 0;
    min-height: 44px;
    border: 1px solid #7a8e96;
    border-radius: 3px;
    padding: 8px;
    background: #fff;
    color: #213039;
  }
  .search-actions {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
    margin-top: 20px;
  }
  button {
    min-height: 44px;
    padding: 8px 14px;
    border: 1px solid #153849;
    border-radius: 3px;
    background: #fff;
    color: #153849;
    cursor: pointer;
  }
  button[type="submit"] {
    background: #153849;
    color: #fff;
  }
  button:disabled {
    cursor: default;
  }
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
  #search-status {
    font-size: 0.875rem;
  }
  [hidden] {
    display: none !important;
  }
  .browse-layout {
    display: grid;
    grid-template-columns: 280px minmax(0, 1fr);
    gap: 24px;
    align-items: start;
  }
  .browse-rail {
    background: #fff;
    border: 1px solid #ccd3d2;
    padding: 24px;
  }
  .browse-rail h1 {
    font-size: 2rem;
    margin-bottom: 20px;
  }
  .browse-rail > p {
    font-size: 0.9rem;
  }
  .information-types {
    list-style: none;
    padding: 0;
    margin-block: 24px;
  }
  .information-types li {
    margin-block: 10px;
    font-size: 0.8rem;
  }
  .information-types .info-label {
    margin-right: 6px;
  }
  .information-types p {
    display: inline;
    margin: 0;
    font-size: inherit;
  }
  .browse-tools {
    border-top: 1px solid #ccd3d2;
    padding-top: 16px;
  }
  .browse-tools h2 {
    margin: 0;
    font-size: 1.25rem;
  }
  .browse-tools p {
    font-size: 0.85rem;
  }
  .results {
    min-width: 0;
    margin-top: 0;
  }
  .results-heading {
    display: flex;
    gap: 16px;
    align-items: baseline;
    justify-content: space-between;
    flex-wrap: wrap;
    margin-bottom: 16px;
  }
  .results-heading h2,
  .results-heading p {
    margin: 0;
  }
  .results-heading p {
    font-size: 0.8rem;
  }
  .results-heading span {
    font-family: system-ui, sans-serif;
    font-size: 1rem;
    margin-left: 8px;
  }
  .spots {
    list-style: none;
    margin: 0;
    padding: 0;
    background: #fff;
    border: 1px solid #ccd3d2;
  }
  .spots li + li {
    border-top: 1px solid #ccd3d2;
  }
  .spots article {
    display: grid;
    grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr) minmax(0, 0.65fr);
    gap: 20px;
    padding: 20px;
    align-items: start;
  }
  .spots p {
    font-size: 0.875rem;
    margin: 0;
  }
  .spots h3 {
    font-size: 1.25rem;
    margin: 0 0 6px;
  }
  .spot-details {
    text-align: right;
  }
  .empty {
    background: #fff;
    border: 1px solid #ccd3d2;
    padding: 24px;
  }
  .empty p {
    margin: 0;
  }
  @media (max-width: 1100px) {
    .spots article {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    }
    .spot-details {
      text-align: left;
      grid-column: 1 / -1;
      display: flex;
      gap: 16px;
      flex-wrap: wrap;
    }
  }
  @media (max-width: 900px) {
    .browse-layout {
      grid-template-columns: minmax(0, 1fr);
    }
    .browse-rail h1 br {
      display: none;
    }
  }
  @media (max-width: 600px) {
    .spots article {
      grid-template-columns: minmax(0, 1fr);
      gap: 10px;
    }
  }
</style>
