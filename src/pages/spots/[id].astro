---
import {
  illustrationUrl,
  illustrationCaption,
} from "../../content/illustration.ts";
import Layout from "../../layouts/Layout.astro";
import { transportSectionTitle } from "../../site.ts";
import ChecklistBody from "../../components/ChecklistBody.astro";
import ExternalLink from "../../components/ExternalLink.astro";
import FactList from "../../components/FactList.astro";
import SpotSection from "../../components/SpotSection.astro";
import { loadPageSpots, type PageSpot } from "../../content/preview.ts";
import { mapLinks } from "../../content/presentation.ts";
import {
  feeFact,
  mapMode,
  preDepartureRows,
  sectionEntries,
  type OperatingStatus,
} from "../../content/spot-page.ts";
export async function getStaticPaths() {
  return (await loadPageSpots(__CARLTRAVEL_DRAFT_PREVIEW__)).map((spot) => ({
    params: { id: spot.id },
    props: { spot },
  }));
}
interface Props {
  spot: PageSpot;
}
const { spot } = Astro.props;
const buildDate = new Date().toISOString().slice(0, 10);
const official = (id: string) =>
  spot.officialRefs.find((ref) => ref.id === id)!;
const source = (id: string) => spot.sources.find((item) => item.id === id)!;
const maps = mapLinks(spot.name, spot.address, spot.location);
// 結構化營運狀態尚無資料來源（H-15），目前一律沒有；欄位到位後由此帶入。
const status: OperatingStatus | null = null;
const rows = preDepartureRows(spot, status);
const sections = sectionEntries(spot, transportSectionTitle);
const nearbyKind = { food: "餐飲", stay: "住宿", activity: "活動" } as const;
---

<Layout title={spot.name}>
  <nav class="breadcrumb" aria-label="麵包屑">
    <a href="/" data-list-return>← 景點列表</a> / {spot.name}
  </nav>
  <article class="spot-article">
    {spot.preview && <p class="preview-label">{spot.preview} · 尚未發布</p>}
    <header>
      <h1
        data-pagefind-body
        data-pagefind-meta="title"
        data-pagefind-weight="10"
      >
        {spot.name}
      </h1>
      <p class="location">
        <span data-pagefind-body>{spot.county} {spot.district}</span> · {
          spot.kind
        } · {spot.setting}
      </p>
      <p class="spot-summary" data-pagefind-body>{spot.summary}</p>
    </header>
    <section class="check" aria-labelledby="check-heading">
      <h2 id="check-heading">出發前確認</h2>
      <div class="rows">
        {
          rows.map((row) => (
            <a
              href={`#${row.to}`}
              data-open
              class:list={[{ strong: row.strong }]}
            >
              <span class="k">{row.label}</span>
              <span>{row.value}</span>
              <span aria-hidden="true">›</span>
            </a>
          ))
        }
      </div>
      <p class="addr">{spot.address}</p>
      {
        mapMode(status) === "quiet" ? (
          <p class="maps-quiet">
            目前休園，仍要查看位置：
            <ExternalLink href={maps.google}>Google Maps 開啟地圖</ExternalLink>
            、
            <ExternalLink href={maps.osm}>OpenStreetMap 開啟地圖</ExternalLink>
          </p>
        ) : (
          <p class="maps">
            <ExternalLink href={maps.google}>Google Maps 開啟地圖</ExternalLink>
            <ExternalLink href={maps.osm}>OpenStreetMap 開啟地圖</ExternalLink>
          </p>
        )
      }
    </section>
    {
      spot.illustration && (
        <figure class="spot-illustration" data-pagefind-ignore>
          <img
            src={`${illustrationUrl(spot.id)}?v=${spot.illustration.sha256}`}
            alt={spot.illustration.alt}
            width={spot.illustration.width}
            height={spot.illustration.height}
            loading="lazy"
            decoding="async"
          />
          <figcaption>{illustrationCaption}</figcaption>
        </figure>
      )
    }
    <div class="acc">
      {
        sections.map((entry) =>
          entry.missing ? (
            <div class="acc-missing">
              <span class="section-title">{entry.label}</span>　
              <span class="g">尚未整理</span>
            </div>
          ) : (
            <SpotSection
              id={entry.id}
              title={entry.label}
              gist={entry.gist}
              tag={entry.tag}
              checkedAt={entry.checkedAt}
              buildDate={buildDate}
              open={entry.id === "checklist"}
            >
              {entry.id === "checklist" && <ChecklistBody spot={spot} />}
              {entry.id === "hours" && (
                <FactList
                  section={spot.hoursAndFees}
                  refs={spot.officialRefs}
                  feeMissing={!feeFact(spot)}
                />
              )}
              {entry.id === "transport" && (
                <FactList section={spot.transport} refs={spot.officialRefs} />
              )}
              {entry.id === "facilities" && spot.facilities && (
                <FactList section={spot.facilities} refs={spot.officialRefs} />
              )}
              {entry.id === "with-kids" && spot.withKids && (
                <>
                  <ul>
                    {spot.withKids.facts.map((fact) => (
                      <li>
                        <span data-pagefind-body>{fact.text}</span>
                        <span class="src">
                          <ExternalLink href={official(fact.ref).url}>
                            出處：{official(fact.ref).title}
                          </ExternalLink>
                        </span>
                      </li>
                    ))}
                  </ul>
                  {spot.withKids.activities.length > 0 && (
                    <div>
                      <h3>Agent 建議的觀察活動</h3>
                      <ul>
                        {spot.withKids.activities.map((activity) => (
                          <li data-pagefind-body>{activity}</li>
                        ))}
                      </ul>
                    </div>
                  )}
                </>
              )}
              {entry.id === "author" &&
                spot.authorNotes.map((note) => (
                  <div class="note">
                    <p data-pagefind-body>{note.summary}</p>
                    {note.quotes.map((quote) => (
                      <blockquote>{quote}</blockquote>
                    ))}
                    <p class="src">
                      原作者：
                      <ExternalLink href={source(note.source).url}>
                        {source(note.source).author} ·{" "}
                        {source(note.source).title}
                      </ExternalLink>
                    </p>
                  </div>
                ))}
              {entry.id === "tips" && (
                <ul>
                  {spot.agentTips.map((tip) => (
                    <li data-pagefind-body>{tip}</li>
                  ))}
                </ul>
              )}
              {entry.id === "nearby" && (
                <ul>
                  {spot.nearby.map((item) => (
                    <li>
                      <strong>{item.name}</strong> · {nearbyKind[item.kind]}：
                      {item.note}
                      {item.source && (
                        <span class="src">
                          <ExternalLink href={source(item.source).url}>
                            來源：{source(item.source).title}
                          </ExternalLink>
                        </span>
                      )}
                    </li>
                  ))}
                </ul>
              )}
              {entry.id === "references" && (
                <div class="refs">
                  <h3>官方出處</h3>
                  <ul>
                    {spot.officialRefs.map((ref) => (
                      <li>
                        <ExternalLink href={ref.url}>{ref.title}</ExternalLink>
                        <span class="src">
                          {ref.organization}
                          {ref.kind === "openData" && (
                            <>
                              {" "}
                              · 開放資料顯名：{ref.attribution.provider}（
                              {ref.attribution.year}）「
                              {ref.attribution.dataset}
                              」版本 {ref.attribution.version} ·{" "}
                              <ExternalLink href="https://data.gov.tw/license">
                                政府資料開放授權條款第 1 版
                              </ExternalLink>
                            </>
                          )}
                          {"\u00a0"}
                        </span>
                      </li>
                    ))}
                  </ul>
                  {spot.tourismId && (
                    <p>
                      觀光署定位 ID：{spot.tourismId.value} ·{" "}
                      <ExternalLink href={official(spot.tourismId.ref).url}>
                        出處：{official(spot.tourismId.ref).title}
                      </ExternalLink>
                    </p>
                  )}
                  {spot.sources.length > 0 && (
                    <>
                      <h3>原始來源</h3>
                      <ul>
                        {spot.sources.map((item) => (
                          <li>
                            <ExternalLink href={item.url}>
                              {item.title}
                            </ExternalLink>
                            <span class="src">
                              {item.author} · 讀取日期 {item.readAt}
                              {!item.readable && " · 原文無法讀取"}
                            </span>
                          </li>
                        ))}
                      </ul>
                    </>
                  )}
                </div>
              )}
            </SpotSection>
          ),
        )
      }
    </div>
    <aside
      id="spot-disclaimer"
      tabindex="-1"
      aria-label="使用前確認"
      class="disclaimer"
    >
      出發前請再確認官方公告；親子與無障礙資訊僅供參考，未知不代表沒有。
      <a href="/about/#disclaimer">查看使用前確認</a>
    </aside>
  </article>
</Layout>
<script>
  import "../../browser/spot-sections.ts";
  import "../../browser/list-return.ts";
</script>
<style>
  .breadcrumb {
    max-width: 760px;
    margin-inline: auto;
    font-size: 14px;
    color: var(--muted);
  }
  .breadcrumb a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
  }
  .spot-article {
    max-width: 760px;
    margin: 0 auto;
    min-width: 0;
  }
  .spot-article h1 {
    margin: 4px 0;
    font-size: clamp(28px, 4vw, 44px);
  }
  .location {
    margin: 0;
    color: var(--ground);
    font-weight: 600;
    font-size: 15px;
  }
  .spot-summary {
    font-size: 18px;
    font-weight: 500;
  }
  .check {
    padding: 16px;
    background: var(--cover);
    border-radius: 16px;
  }
  .check h2 {
    margin: 0 0 8px;
    font-size: 20px;
  }
  .rows {
    background: var(--paper);
    border-radius: 10px;
    overflow: hidden;
  }
  .rows a {
    display: grid;
    grid-template-columns: 5.5em minmax(0, 1fr) auto;
    gap: 8px;
    align-items: center;
    min-height: 48px;
    padding: 8px 12px;
    border-bottom: 1px solid var(--line);
    text-decoration: none;
  }
  .rows a:last-child {
    border-bottom: 0;
  }
  .rows a.strong {
    background: var(--ink);
    color: var(--paper);
  }
  .rows a:focus-visible {
    outline-offset: -3px;
  }
  .k {
    font-weight: 600;
    font-size: 15px;
  }
  .addr {
    margin-bottom: 8px;
    font-size: 15px;
  }
  .maps {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 0;
  }
  .maps :global(a) {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 6px 14px;
    border: 1px solid var(--ground);
    border-radius: 10px;
    background: var(--paper);
    text-decoration: none;
  }
  .maps-quiet {
    margin: 0;
    font-size: 15px;
  }
  .maps-quiet :global(a) {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
  }
  .spot-illustration {
    margin: 24px 0 0;
  }
  .spot-illustration img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 20px 20px 20px 6px;
  }
  .spot-illustration figcaption {
    margin-top: 10px;
    color: var(--muted);
    font-size: 14px;
  }
  .acc {
    margin-top: 24px;
    border-top: 1px solid var(--line);
  }
  .acc-missing {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    min-height: 56px;
    padding: 8px 4px;
    border-bottom: 1px solid var(--line);
    color: var(--muted);
  }
  .acc-missing .section-title {
    font-size: 18px;
    font-weight: 700;
  }
  .acc-missing .g {
    font-size: 14px;
  }
  .spot-article :global(ul) {
    padding-left: 20px;
  }
  .spot-article :global(li) {
    margin-block: 10px;
  }
  .src {
    display: block;
    margin-top: 4px;
    font-size: 14px;
  }
  .refs {
    font-size: 15px;
  }
  .refs ul {
    padding: 0;
    list-style: none;
  }
  .refs li {
    padding-block: 10px;
    border-bottom: 1px solid var(--line);
  }
  blockquote {
    margin-inline: 0;
    padding: 14px 18px;
    background: var(--paper-deep);
    border-left: 3px solid var(--ground);
    border-radius: 0 10px 10px 0;
  }
  .disclaimer {
    margin-top: 32px;
    padding: 20px;
    border-radius: 12px;
    background: var(--paper-deep);
    scroll-margin-top: 24px;
  }
</style>
