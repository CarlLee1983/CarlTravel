{
  "name": "carltravel",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.0.0",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=12.0.0"
  },
  "scripts": {
    "dev": "node scripts/site.mjs dev",
    "dev:fixture": "node scripts/site.mjs dev fixture",
    "build": "node scripts/site.mjs build",
    "build:fixture": "node scripts/site.mjs build fixture",
    "preview": "node scripts/site.mjs preview",
    "preview:fixture": "node scripts/site.mjs preview fixture",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "astro check",
    "check:content": "node scripts/site.mjs check-content",
    "check:output": "node --experimental-strip-types scripts/check-output.ts",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "test:e2e": "pnpm build:fixture && playwright test",
    "verify": "node scripts/verify.mjs"
  },
  "dependencies": {
    "astro": "7.2.9",
    "yaml": "2.8.3",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@types/node": "22.20.5",
    "pagefind": "1.5.2",
    "prettier": "3.9.6",
    "prettier-plugin-astro": "0.14.1",
    "typescript": "6.0.3"
  }
}
