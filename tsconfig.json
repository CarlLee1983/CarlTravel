{
  "extends": "astro/tsconfigs/strict",
  "include": [
    ".astro/types.d.ts",
    "src/**/*",
    "scripts/**/*",
    "tests/**/*",
    "e2e/**/*",
    "playwright.config.ts"
  ],
  "exclude": ["dist", "dist-fixture", "node_modules"],
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noUncheckedIndexedAccess": true,
    "verbatimModuleSyntax": true
  }
}
